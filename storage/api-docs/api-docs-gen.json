                        }
                    }
                }
            }
        },
        "/api/v1/app/get_dialysis_centers": {
            "get": {
                "tags": [
                    "GeneralApiSection"
                ],
                "summary": "Get Dialysis Centers API",
                "description": "Get Dialysis Centers Objects",
                "operationId": "get_dialysis_centers",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/language"
